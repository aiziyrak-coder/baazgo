# Copy to /opt/baazgo/app/.env.api on the server (chmod 600).
# API listens only on loopback; nginx terminates TLS on baazgoapi.ziyrak.org

NODE_ENV=production
API_ONLY=true
PORT=3010
HOST=127.0.0.1
CORS_ORIGINS=https://baazgo.ziyrak.org

# Trust X-Forwarded-* from nginx (required for rate limiting by real client IP)
TRUST_PROXY=1

# Optional: max /api requests per IP per minute (default 200)
# RATE_LIMIT_MAX_PER_MIN=200
